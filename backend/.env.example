# PostgreSQL URI for the application. Replace the placeholder credentials.
DATABASE_URL=postgresql+psycopg://app_user:replace-me@localhost:5432/reprocare
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
SESSION_DAYS=14
ALLOW_DEMO_ACCOUNTS=false

# Optional server/bot integrations. Keep real keys in private configuration.
IMPORT_API_KEY=
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=
# REPROCARE_BOT_HOME=/path/outside/repository
REPROCARE_BOT_BROWSER_PATH=
REPROCARE_BOT_HEADLESS=true
REPROCARE_BOT_NO_PROMPT=false
REPROCARE_PLACES_DAILY_LIMIT=100

# Set only for dedicated disposable test databases. Test schemas are reset.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:replace-me@localhost:5432/reprocare_test
# TEST_SCRATCH_DATABASE_URL=postgresql+psycopg://test_user:replace-me@localhost:5432/reprocare_scratch

# Loopback-only demo of previously collected Facebook activity
LOCAL_FACEBOOK_DEMO=false

# Optional Google OAuth. Requires separate database and provider authorization.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:15173/auth/google/callback

# Optional email password recovery. Apply the approved recovery migration and configure an
# approved mail service before enabling. Keep SMTP credentials in the private environment.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_ORIGIN=
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_SECURITY=starttls
PASSWORD_RESET_SMTP_USER=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_FROM=

# Optional Cloudinary facility photo uploads (signed by the backend; the secret never reaches the browser).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=reprocare/facilities
