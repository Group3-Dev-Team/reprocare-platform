# Public build-time settings. Never put server secrets in VITE_* variables.
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
# Optional browser-restricted Google Maps JavaScript API key.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# HTTPS origin for a future public production deployment. Leave blank for local and preview builds.
VITE_PUBLIC_SITE_URL=

# Optional authorized public WhatsApp support number in international format.
VITE_WHATSAPP_SUPPORT_NUMBER=
